frontend/public/live2d/core/*
!frontend/public/live2d/core/.gitkeep
frontend/public/live2d/models/*
!frontend/public/live2d/models/.gitkeep

# --- Runtime ---
.run/
*.pid
backend/cache/
svc_service/cache/
hubert/
pretrain/

