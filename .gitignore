# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
frontend/dist/
frontend/.vite/
*.log
