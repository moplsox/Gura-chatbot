# Paths are relative to the repo root unless absolute
SVC_MODEL_PATH=models/svc/G_10000.pth
SVC_CONFIG_PATH=models/svc/config.json
# optional cluster model
SVC_CLUSTER_PATH=
# speaker name from config.json "spk" map (leave empty for the first speaker)
SVC_SPEAKER=
# auto | cpu | mps | cuda
SVC_DEVICE=auto
# F0 method: dio | harvest | crepe | crepe-tiny | parselmouth | rmvpe (rmvpe needs rmvpe.pt)
SVC_F0_METHOD=dio
# semitone shift applied to the TTS input (female TTS voice → 0; male voice → +12)
SVC_TRANSPOSE=0
# Automatic F0 prediction (ignore pitch of input; usually off for singing, on/off for speech by taste)
SVC_AUTO_PREDICT_F0=false
SVC_NOISE_SCALE=0.4
SVC_CLUSTER_RATIO=0.0
SVC_PORT=8100
