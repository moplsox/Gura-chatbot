# ============ Gura AI Live2D Voice Chat — environment ============
# Copy to .env and fill in. Never commit .env.

# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Comma separated origins allowed by CORS (dev frontend + LAN access from iPhone)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---- LLM (provider-agnostic) ----
# LLM_PROVIDER: openai_compatible | anthropic | mock
#   openai_compatible works with OpenAI, OpenRouter, DeepSeek, Groq, Ollama, LM Studio, etc.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For OpenAI-compatible providers. Examples:
#   https://api.openai.com/v1   https://openrouter.ai/api/v1   http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_HISTORY_TURNS=12
LLM_TEMPERATURE=0.8

# ---- STT (speech to text) ----
# STT_PROVIDER: faster_whisper | disabled
STT_PROVIDER=faster_whisper
# tiny | base | small | medium | large-v3 | distil-large-v3  (small is a good Mac CPU default)
STT_MODEL=small
# cpu | auto  (faster-whisper does not support Apple MPS; CPU int8 is the Mac path)
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# ---- TTS (text to speech) ----
# TTS_PROVIDER: edge | openai_compatible | disabled
#   edge = free Microsoft Edge neural voices (needs internet, no key). English quality is good.
TTS_PROVIDER=edge
TTS_VOICE_EN=en-US-AnaNeural
TTS_VOICE_ZH=zh-TW-HsiaoYuNeural
TTS_RATE=+5%
TTS_PITCH=+0Hz
# Only for TTS_PROVIDER=openai_compatible (OpenAI tts-1 / gpt-4o-mini-tts or a compatible server).
# Leave URL/key empty to reuse LLM_BASE_URL / LLM_API_KEY.
TTS_OPENAI_BASE_URL=
TTS_OPENAI_API_KEY=
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_OPENAI_VOICE_EN=coral
TTS_OPENAI_VOICE_ZH=coral

# ---- Voice conversion (So-VITS-SVC, runs as a separate service) ----
# VC_PROVIDER: sovits_http | disabled
VC_PROVIDER=disabled
VC_SERVICE_URL=http://127.0.0.1:8100
VC_TIMEOUT_SECONDS=60
# Fall back to the plain TTS voice if conversion fails or times out
VC_FALLBACK_TO_TTS=true

# ---- Live2D ----
# Path (served by the frontend dev server / backend) to the model3.json to load by default
LIVE2D_MODEL_URL=/live2d/models/Haru/Haru.model3.json
